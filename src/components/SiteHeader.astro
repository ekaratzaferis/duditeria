---
interface Props {
  current?: 'home' | 'projects' | 'resume' | 'contact';
}

const { current = 'home' } = Astro.props;

const links = [
  { href: '/projects', label: 'Projects', key: 'projects' },
  { href: '/resume', label: 'Resume', key: 'resume' },
];
---

<header class="site-header">
  <div class="inner">
    <a href="/" class="wordmark" aria-label="Duditeria — home">
      <span class="mark" aria-hidden="true"></span>
      Duditeria
    </a>

    <nav aria-label="Main navigation">
      {links.map((l) => (
        <a href={l.href} class:list={['nav-link', { active: current === l.key }]} aria-current={current === l.key ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
      <a href="/contact" class:list={['nav-cta', { active: current === 'contact' }]} aria-current={current === 'contact' ? 'page' : undefined}>
        Contact
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    font-family: var(--font-sans);
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(8, 8, 10, 0.72);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--m-border);
  }

  .inner {
    max-width: 1160px;
    margin: 0 auto;
    height: 3.75rem;
    padding: 0 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: 'Roboto Condensed', var(--font-sans);
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--m-text);
  }

  /* A small lit "lamp" — nod to the old homepage */
  .mark {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--m-accent);
    box-shadow: 0 0 12px 2px rgba(255, 178, 36, 0.55);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    font-size: 0.85rem;
    color: var(--m-text-2);
    padding: 0.45rem 0.75rem;
    border-radius: 8px;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .nav-link:hover {
    color: var(--m-text);
    background: var(--m-surface-2);
  }

  .nav-link.active {
    color: var(--m-text);
  }

  .nav-cta {
    margin-left: 0.5rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: #0b0b0b;
    background: var(--m-text);
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    transition: background 0.2s ease;
  }

  .nav-cta:hover,
  .nav-cta.active {
    background: var(--m-accent);
  }

  @media (max-width: 480px) {
    .wordmark {
      font-size: 0.75rem;
      letter-spacing: 0.24em;
    }
    .nav-link {
      padding: 0.45rem 0.5rem;
      font-size: 0.8rem;
    }
    .nav-cta {
      margin-left: 0.25rem;
      font-size: 0.8rem;
      padding: 0.4rem 0.8rem;
    }
  }
</style>
