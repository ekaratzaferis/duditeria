---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';
import { approach } from '../data/approach';

const toolbox = [
  {
    group: 'Architecture & delivery',
    items: ['System design', 'API contracts', 'Domain modelling', 'Code review', 'Tech-debt strategy', 'Agile'],
  },
  {
    group: 'AI-native engineering',
    items: ['AI coding agents', 'Spec & context design', 'Agent guardrails', 'LLM integration'],
  },
  {
    group: 'Stack',
    items: ['Node.js', 'TypeScript', 'React', 'Python', 'MongoDB', 'Redis', 'Docker', 'Kubernetes', 'Cloud', 'REST'],
  },
];
---

<Base
  modern
  title="Resume — Alexandros Karatzaferis"
  description="Software Architect with 10+ years of experience. I translate business requirements into system architecture, orchestrate AI agents to build it, review what they ship, and own the result."
  canonical="https://duditeria.com/resume"
>
  <SiteHeader current="resume" />

  <main>
    <div class="bento">

      <!-- ── Name ─────────────────────────────────────────────────── -->
      <section class="card card-name" data-reveal style="--d:0">
        <p class="eyebrow eyebrow-accent">Software Architect · AI-native delivery</p>
        <h1 class="name-text">Alexandros<br />Karatzaferis</h1>
        <p class="name-sub">10+ years · Athens · Remote</p>
      </section>

      <!-- ── Photo ────────────────────────────────────────────────── -->
      <div class="card card-photo" data-reveal style="--d:1">
        <img src="/alex.webp" alt="Alexandros Karatzaferis" class="photo-img" />
      </div>

      <!-- ── Approach ─────────────────────────────────────────────── -->
      <section class="card card-approach" data-reveal style="--d:2">
        <h2 class="headline">The intent is mine.<br /><span>Agents are how it gets built.</span></h2>
        <ol class="steps">
          {approach.map((s) => (
            <li class="step">
              <span class="step-n">{s.n}</span>
              <h3 class="step-title">{s.title}</h3>
              <p class="step-text">{s.text}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- ── Experience ───────────────────────────────────────────── -->
      <section class="card card-exp" data-reveal style="--d:3">
        <h2 class="card-label">Experience</h2>

        <div class="tl">

          <article class="tl-item current">
            <div class="tl-head">
              <div>
                <h3 class="tl-role">Software Architect</h3>
                <p class="tl-company">THEFUTUREOFJEWELRY · Remote</p>
              </div>
              <span class="tl-dates">Feb 2020 – Present</span>
            </div>
            <ul class="tl-bullets">
              <li>Designed and own the core product architecture — stable enough to absorb major product pivots without rewrites, and trusted enough that engineering decisions rarely need defending.</li>
              <li>Sit between the C-suite and the build: turn product uncertainty into technical direction, and technical trade-offs back into business language that leadership can decide on.</li>
              <li>Brought AI coding agents into the workflow early, before it was fashionable, and raised junior engineer productivity by ~25%. Since then I've reshaped delivery so agents carry a growing share of implementation, while I own the specs, the architecture and the review gate.</li>
              <li>Built the guardrails that make agent-written code safe to ship: clear module boundaries, written contracts, and a review process where nothing merges without architectural sign-off.</li>
              <li>Kept the architecture simple enough that new engineers ship within their first week, and agents can work in it without getting lost. KISS isn't a wall poster. It's how we build.</li>
              <li>Reframed technical debt from a morale problem into a shared roadmap, and mentored a 7-person engineering team through it.</li>
              <li>Set up two-week sprints to build delivery habits, then let the team outgrow them. Deploys now follow business rhythm, not calendar pressure.</li>
            </ul>
          </article>

          <article class="tl-item">
            <div class="tl-head">
              <div>
                <h3 class="tl-role">Software Engineer</h3>
                <p class="tl-company">Viral Loops · Athens</p>
              </div>
              <span class="tl-dates">Jan 2018 – Jan 2020</span>
            </div>
            <ul class="tl-bullets">
              <li>Owned feature development end-to-end on a viral marketing platform. Picked up an unfamiliar codebase fast and shipped reliably without handholding.</li>
              <li>Worked at real production scale: thousands of concurrent users, sharp spikes during campaign launches, and background jobs that couldn't slip under pressure.</li>
            </ul>
          </article>

          <article class="tl-item">
            <div class="tl-head">
              <div>
                <h3 class="tl-role">Node.js Software Engineer</h3>
                <p class="tl-company">wappier · Athens</p>
              </div>
              <span class="tl-dates">Jan – Dec 2017</span>
            </div>
            <ul class="tl-bullets">
              <li>Full-stack engineer on a MongoDB–Node–Angular revenue management platform. Learned the stack, found my footing quickly, and contributed without drama.</li>
            </ul>
          </article>

          <article class="tl-item">
            <div class="tl-head">
              <div>
                <h3 class="tl-role">Front-End Developer</h3>
                <p class="tl-company">University of São Paulo – IPEN · Athens</p>
              </div>
              <span class="tl-dates">Sep 2015 – Dec 2016</span>
            </div>
            <ul class="tl-bullets">
              <li>Built a scientific crystal-structure visualisation tool for researchers. I knew nothing about the domain before I started, which turned out to be the point.</li>
            </ul>
          </article>

        </div>
      </section>

      <!-- ── About ────────────────────────────────────────────────── -->
      <section class="card card-about" data-reveal style="--d:4">
        <h2 class="card-label">About</h2>
        <p class="about-text">
          Writing code is no longer the bottleneck. Knowing <em>what</em> to build, how it should fit together, and whether what got built is actually right: that's the hard part now. It's also the job I've been doing since 2020.
        </p>
        <p class="about-text">
          I work as the architect between the business and the build. I turn fuzzy requirements into system designs with clear boundaries and contracts, hand well-scoped work to AI agents, make sure what comes back is what was asked for, and answer for the result. Agents made us faster. They didn't make anyone less accountable.
        </p>
        <p class="about-text">
          I still care about the people side too: mentoring, trust, teams that ship without drama. The best systems are built by people who know what they're building toward.
        </p>
      </section>

      <!-- ── Contact ──────────────────────────────────────────────── -->
      <a href="/contact" class="card card-contact" data-reveal style="--d:5">
        <span class="eyebrow">Have a system that needs an owner?</span>
        <span class="contact-cta">
          <span class="contact-cta-text">Let's talk</span>
          <span class="arrow" aria-hidden="true">→</span>
        </span>
      </a>

      <!-- ── Education + Languages ────────────────────────────────── -->
      <section class="card card-edu" data-reveal style="--d:6">
        <h2 class="card-label">Education</h2>
        <p class="edu-degree">Electronic &amp; Computer Engineering</p>
        <p class="edu-school">Technical University of Crete</p>
        <p class="edu-detail">B.Eng. · 2007 – 2015</p>

        <h2 class="card-label lang-label">Languages</h2>
        <div class="lang-row"><span>English</span><span class="lang-level">Bilingual</span></div>
        <div class="lang-row"><span>Greek</span><span class="lang-level">Native</span></div>
      </section>

      <!-- ── Going deep ───────────────────────────────────────────── -->
      <section class="card card-explore" data-reveal style="--d:7">
        <h2 class="card-label">Going deep</h2>
        <p class="explore-why">
          Before I rely on something, I try to understand what it actually is. I did it with the JS event loop and Python's GIL. Now I'm doing it with AI, learning the math and mechanics from the ground up, because you can't direct a tool well if you don't know how it fails.
        </p>
        <div class="tags">
          <span class="tag">Linear algebra</span>
          <span class="tag">Neural networks</span>
          <span class="tag">Backpropagation</span>
          <span class="tag">Transformers</span>
          <span class="tag">Attention</span>
          <span class="tag">CNNs</span>
        </div>
      </section>

      <!-- ── Toolbox ──────────────────────────────────────────────── -->
      <section class="card card-skills" data-reveal style="--d:8">
        <h2 class="card-label">Toolbox</h2>
        {toolbox.map((g) => (
          <div class="tool-group">
            <h3 class="tool-group-title">{g.group}</h3>
            <div class="tags">
              {g.items.map((i) => <span class="tag">{i}</span>)}
            </div>
          </div>
        ))}
      </section>

      <!-- ── Work ─────────────────────────────────────────────────── -->
      <a href="https://github.com/ekaratzaferis" target="_blank" rel="noopener" class="card card-work" data-reveal style="--d:9">
        <span class="eyebrow">Open source</span>
        <span class="work-title">github.com/ekaratzaferis</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>

    </div>
  </main>
</Base>

<script>
  const els = document.querySelectorAll('[data-reveal]');
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          io.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.06, rootMargin: '0px 0px -20px 0px' }
  );
  els.forEach((el) => io.observe(el));
</script>

<style>
  main {
    max-width: 1160px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 5rem;
  }

  /* ── Grid ────────────────────────────────────────────────────────── */
  .bento {
    display: grid;
    grid-template-columns: 1fr 1fr 1.55fr;
    grid-template-areas:
      "name     photo    exp"
      "approach approach exp"
      "about    about    exp"
      "edu      contact  exp"
      "skills   skills   explore"
      "skills   skills   work";
    gap: 12px;
  }

  .card-name     { grid-area: name; }
  .card-photo    { grid-area: photo; }
  .card-approach { grid-area: approach; }
  .card-exp      { grid-area: exp; }
  .card-about    { grid-area: about; }
  .card-contact  { grid-area: contact; }
  .card-edu      { grid-area: edu; }
  .card-explore  { grid-area: explore; }
  .card-skills   { grid-area: skills; }
  .card-work     { grid-area: work; }

  /* ── Card base ───────────────────────────────────────────────────── */
  .card {
    position: relative;
    display: block;
    background: linear-gradient(180deg, var(--m-surface) 0%, rgba(15, 15, 18, 0.7) 100%);
    border: 1px solid var(--m-border);
    border-radius: var(--m-radius);
    padding: 1.75rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
    transition:
      opacity 0.6s ease calc(var(--d, 0) * 70ms),
      transform 0.6s ease calc(var(--d, 0) * 70ms),
      border-color 0.25s ease;
  }

  a.card:hover {
    border-color: var(--m-border-strong);
  }

  .card-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--m-text-3);
    margin-bottom: 1.25rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag {
    font-size: 0.8rem;
    color: var(--m-text-2);
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--m-border);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.015);
  }

  .arrow {
    font-size: 1.25rem;
    color: var(--m-text-3);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  a.card:hover .arrow {
    color: var(--m-accent);
    transform: translateX(3px);
  }

  /* ── Name ────────────────────────────────────────────────────────── */
  .card-name {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    min-height: 340px;
  }

  .name-text {
    font-size: clamp(2.2rem, 3.6vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.02;
    color: var(--m-text);
    margin-top: auto;
  }

  .name-sub {
    font-size: 0.9rem;
    color: var(--m-text-3);
    margin-top: -1.25rem;
  }

  /* ── Photo ───────────────────────────────────────────────────────── */
  .card-photo {
    padding: 0;
    overflow: hidden;
    min-height: 340px;
  }

  .photo-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 40% 10%;
    filter: grayscale(0.35) contrast(1.05);
  }

  /* ── Approach ────────────────────────────────────────────────────── */
  .headline {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--m-text);
    margin-bottom: 1.75rem;
  }

  .headline span {
    color: var(--m-accent);
  }

  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--m-border);
    border: 1px solid var(--m-border);
    border-radius: 12px;
    overflow: hidden;
  }

  .step {
    background: var(--m-surface);
    padding: 1.1rem 1.2rem 1.25rem;
  }

  .step-n {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--m-accent);
  }

  .step-title {
    font-size: 1rem;
    font-weight: 500;
    color: var(--m-text);
    margin: 0.35rem 0 0.35rem;
  }

  .step-text {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--m-text-2);
  }

  /* ── Experience ──────────────────────────────────────────────────── */
  .card-exp {
    padding: 2rem;
  }

  .tl {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    padding-left: 1.25rem;
    border-left: 1px solid var(--m-border);
  }

  .tl-item {
    position: relative;
  }

  .tl-item::before {
    content: '';
    position: absolute;
    left: calc(-1.25rem - 4.5px);
    top: 0.45rem;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--m-bg);
    border: 1px solid var(--m-border-strong);
  }

  .tl-item.current::before {
    background: var(--m-accent);
    border-color: var(--m-accent);
    box-shadow: 0 0 10px rgba(255, 178, 36, 0.6);
  }

  .tl-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.8rem;
  }

  .tl-role {
    font-size: 1.08rem;
    font-weight: 500;
    color: var(--m-text);
    letter-spacing: -0.01em;
  }

  .tl-company {
    font-size: 0.82rem;
    color: var(--m-text-3);
    margin-top: 0.15rem;
  }

  .tl-dates {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--m-text-3);
    white-space: nowrap;
    padding-top: 0.25rem;
  }

  .tl-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .tl-bullets li {
    position: relative;
    padding-left: 1rem;
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--m-text-2);
  }

  .tl-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 5px;
    height: 1px;
    background: var(--m-text-3);
  }

  /* ── About ───────────────────────────────────────────────────────── */
  .card-about {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .card-about .card-label {
    margin-bottom: 0.35rem;
  }

  .about-text {
    font-size: 0.98rem;
    line-height: 1.75;
    color: var(--m-text-2);
  }

  .about-text em {
    color: var(--m-text);
    font-style: normal;
  }

  /* ── Contact ─────────────────────────────────────────────────────── */
  .card-contact {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    min-height: 180px;
    background:
      radial-gradient(120% 120% at 100% 100%, var(--m-accent-soft), transparent 60%),
      var(--m-surface);
  }

  .contact-cta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .contact-cta-text {
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--m-text);
  }

  /* ── Education ───────────────────────────────────────────────────── */
  .edu-degree {
    font-size: 1rem;
    color: var(--m-text);
    margin-bottom: 0.25rem;
  }

  .edu-school {
    font-size: 0.88rem;
    color: var(--m-text-2);
  }

  .edu-detail {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--m-text-3);
    margin-top: 0.3rem;
  }

  .lang-label {
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .lang-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.45rem 0;
    font-size: 0.92rem;
    color: var(--m-text);
    border-bottom: 1px solid var(--m-border);
  }

  .lang-row:last-child { border-bottom: none; }

  .lang-level {
    font-size: 0.82rem;
    color: var(--m-text-3);
  }

  /* ── Explore ─────────────────────────────────────────────────────── */
  .explore-why {
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--m-text-2);
    margin-bottom: 1.25rem;
  }

  /* ── Toolbox ─────────────────────────────────────────────────────── */
  .tool-group + .tool-group {
    margin-top: 1.25rem;
  }

  .tool-group-title {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--m-text);
    margin-bottom: 0.6rem;
  }

  /* ── Work ────────────────────────────────────────────────────────── */
  .card-work {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
  }

  .work-title {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--m-text);
  }

  /* ── Tablet ──────────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .bento {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        "name     photo"
        "approach approach"
        "about    about"
        "exp      exp"
        "explore  skills"
        "edu      contact"
        "work     work";
    }

  }

  /* ── Mobile ──────────────────────────────────────────────────────── */
  @media (max-width: 600px) {
    main { padding: 1rem 1rem 4rem; }

    .bento {
      grid-template-columns: 1fr;
      grid-template-areas:
        "name"
        "photo"
        "approach"
        "about"
        "contact"
        "exp"
        "skills"
        "explore"
        "edu"
        "work";
    }

    .card { padding: 1.4rem; }
    .card-exp { padding: 1.4rem; }
    .card-name { min-height: 240px; }
    .card-photo { min-height: 320px; }
    .steps { grid-template-columns: 1fr; }
    .tl-head { flex-direction: column; gap: 0.35rem; }
    .tl-dates { padding-top: 0; }
  }
</style>
