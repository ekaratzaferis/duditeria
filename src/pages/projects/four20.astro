---
import ProjectLayout from '../../layouts/ProjectLayout.astro';

const fonts = ['Permanent Marker', 'Anton', 'Pacifico', 'Abril Fatface', 'Bebas Neue', 'Geist'];
---

<ProjectLayout slug="four20" compactHero hint="Pick a source · drag to rotate">
  <div slot="scene" class="f20" data-f20 data-source="portrait">
    <canvas id="four20-canvas" aria-label="Terraced 3D relief traced from an image"></canvas>

    <div class="panel">
      <div class="tabs" role="tablist" aria-label="Image source">
        <button type="button" role="tab" data-source="portrait" aria-selected="true">Portrait</button>
        <button type="button" role="tab" data-source="text" aria-selected="false">Text</button>
        <button type="button" role="tab" data-source="upload" aria-selected="false">Upload</button>
        <button type="button" role="tab" data-source="camera" aria-selected="false">Camera</button>
      </div>

      <div class="row only-text">
        <input id="f20-text" type="text" value="four20" maxlength="16" autocomplete="off" spellcheck="false" aria-label="Text to trace" />
        <select id="f20-font" aria-label="Font">
          {fonts.map((f) => <option value={f}>{f}</option>)}
        </select>
      </div>

      <div class="row only-camera">
        <video id="f20-video" playsinline muted></video>
        <button type="button" id="f20-capture" class="capture">Take photo</button>
        <p class="denied">Camera unavailable. Try Upload instead.</p>
      </div>

      <div class="row controls">
        <label class="levels">
          <span>Layers <output id="f20-levels-out">5</output></span>
          <input id="f20-levels" type="range" min="2" max="7" value="5" />
        </label>
        <button type="button" id="f20-invert" class="invert" aria-pressed="false">Invert</button>
      </div>

      <div class="preview">
        <div id="f20-svg" class="svg"></div>
        <div class="preview-foot">
          <span class="label">SVG output</span>
          <span id="f20-stats" class="stats"></span>
        </div>
      </div>

      <input id="f20-file" type="file" accept="image/*" hidden />
      <p class="privacy">Everything runs in your browser. Nothing is uploaded.</p>
    </div>
  </div>

  <section>
    <h2>What it does</h2>
    <p class="lead">four20 traces raster images into clean SVG paths in the browser, and makes sure those paths can be extruded into 3D without any cleanup.</p>
  </section>

  <section>
    <h2>The scene above</h2>
    <p>
      The image is split into brightness bands. Each band becomes a black-and-white mask, four20 traces it to
      SVG, and Three.js extrudes the paths. Stacked on top of each other, the layers become a terraced relief,
      a topographic map of the picture. Text is blurred first, so each band is a slightly smaller outline and
      the letters come out inflated.
    </p>
    <p>
      Every band is full of nested shapes: islands inside holes inside outlines. That's exactly the case that
      breaks naive tracing, and the reason four20 exists.
    </p>
  </section>

  <section>
    <h2>Why it exists</h2>
    <p>
      Three.js can extrude any 2D shape with <code>ExtrudeGeometry</code>, but outer paths must wind one way and
      holes the other. Get it wrong and faces invert, surfaces vanish and the geometry breaks.
    </p>
    <p>
      Every potrace port I found produced paths in arbitrary winding order. four20 adds a geometric post-pass:
      it works out which paths contain which, and re-orders the winding so the output is always ready to extrude.
    </p>
  </section>

  <section>
    <h2>How it works</h2>
    <ul class="list">
      <li>Pixels are traced with Peter Selinger's potrace algorithm, the same foundation as Inkscape's bitmap tracing: polygon fitting, then curve optimisation into a minimal set of Bézier curves</li>
      <li>Output paths are compared with point-in-polygon tests to build a containment tree</li>
      <li>Containment depth decides winding: even depth is an outline, odd depth is a hole</li>
      <li>Text is rendered with the browser's font engine first, so any web font works</li>
    </ul>
  </section>
</ProjectLayout>

<script>
  import { initFour20Engine } from '../../scripts/four20-engine.js';

  const root = document.querySelector<HTMLElement>('[data-f20]');
  const canvas = document.getElementById('four20-canvas') as HTMLCanvasElement | null;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

  if (root && canvas) {
    initFour20Engine(canvas, {
      root,
      sourceTabs: Array.from(root.querySelectorAll<HTMLButtonElement>('[data-source]')).filter((el) => el.tagName === 'BUTTON'),
      textInput: $<HTMLInputElement>('f20-text'),
      fontSelect: $<HTMLSelectElement>('f20-font'),
      levels: $<HTMLInputElement>('f20-levels'),
      levelsOut: $('f20-levels-out'),
      invertBtn: $<HTMLButtonElement>('f20-invert'),
      fileInput: $<HTMLInputElement>('f20-file'),
      video: $<HTMLVideoElement>('f20-video'),
      captureBtn: $<HTMLButtonElement>('f20-capture'),
      svgPreview: $('f20-svg'),
      stats: $('f20-stats'),
      portraitSrc: '/four20-portrait.jpg',
    })
      .then((dispose) => window.addEventListener('pagehide', dispose, { once: true }))
      .catch((err) => console.error('[four20-engine] init failed:', err));
  }
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Abril+Fatface&family=Anton&family=Bebas+Neue&family=Pacifico&family=Permanent+Marker&display=swap');

  .f20 {
    position: absolute;
    inset: 0;
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    touch-action: pan-y;
    cursor: grab;
  }

  canvas:active {
    cursor: grabbing;
  }

  .panel {
    position: absolute;
    right: clamp(1rem, 3vw, 2.5rem);
    bottom: clamp(1rem, 4vh, 2.5rem);
    z-index: 4;
    width: 320px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.85rem;
    background: rgba(12, 12, 15, 0.78);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border: 1px solid var(--m-border-strong);
    border-radius: 16px;
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.9);
  }

  .tabs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3px;
    padding: 3px;
    background: var(--m-bg);
    border: 1px solid var(--m-border);
    border-radius: 10px;
  }

  .tabs button {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--m-text-2);
    background: none;
    border: 0;
    border-radius: 7px;
    padding: 0.4rem 0;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .tabs button:hover {
    color: var(--m-text);
  }

  .tabs button[aria-selected='true'] {
    color: #0b0b0b;
    background: var(--m-text);
  }

  .row {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .only-text,
  .only-camera {
    display: none;
  }

  .f20[data-source='text'] .only-text,
  .f20[data-source='camera'] .only-camera {
    display: flex;
  }

  input[type='text'],
  select {
    min-width: 0;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--m-text);
    background: var(--m-bg);
    border: 1px solid var(--m-border-strong);
    border-radius: 8px;
    padding: 0.45rem 0.6rem;
    outline: none;
  }

  input[type='text'] {
    flex: 1;
  }

  select {
    flex: 0 0 auto;
    max-width: 9rem;
  }

  input[type='text']:focus,
  select:focus {
    border-color: rgba(255, 178, 36, 0.6);
  }

  .only-camera {
    flex-direction: column;
    align-items: stretch;
  }

  video {
    display: none;
    width: 100%;
    border-radius: 8px;
    transform: scaleX(-1);
    background: #000;
  }

  .f20:global(.camera-live) video {
    display: block;
  }

  .capture {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    color: #0b0b0b;
    background: var(--m-accent);
    border: 0;
    border-radius: 8px;
    padding: 0.5rem;
    cursor: pointer;
    display: none;
  }

  .f20:global(.camera-live) .capture {
    display: block;
  }

  .denied {
    display: none;
    font-size: 0.8rem;
    color: var(--m-text-3);
  }

  .f20:global(.camera-denied) .denied {
    display: block;
  }

  .controls {
    justify-content: space-between;
  }

  .levels {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.75rem;
    color: var(--m-text-2);
  }

  .levels output {
    font-family: var(--font-mono);
    color: var(--m-accent);
    margin-left: 0.3rem;
  }

  input[type='range'] {
    accent-color: var(--m-accent);
    width: 100%;
  }

  .invert {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--m-text-2);
    background: none;
    border: 1px solid var(--m-border-strong);
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    cursor: pointer;
  }

  .invert[aria-pressed='true'] {
    color: #0b0b0b;
    background: var(--m-accent);
    border-color: var(--m-accent);
  }

  .preview {
    border: 1px solid var(--m-border);
    border-radius: 10px;
    background: #f4f1ea;
    overflow: hidden;
    transition: opacity 0.2s ease;
  }

  .f20:global(.busy) .preview {
    opacity: 0.55;
  }

  .svg {
    height: 110px;
    padding: 0.5rem;
  }

  .svg :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .preview-foot {
    display: flex;
    justify-content: space-between;
    padding: 0.35rem 0.6rem;
    background: var(--m-surface);
    border-top: 1px solid var(--m-border);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--m-text-3);
  }

  .stats {
    color: var(--m-text-2);
  }

  .privacy {
    font-size: 0.7rem;
    color: var(--m-text-3);
  }

  @media (max-width: 700px) {
    .panel {
      left: 0.75rem;
      right: 0.75rem;
      bottom: 0.75rem;
      width: auto;
      gap: 0.55rem;
      padding: 0.65rem;
    }
    .svg { height: 64px; }
    .privacy { display: none; }
  }
</style>
