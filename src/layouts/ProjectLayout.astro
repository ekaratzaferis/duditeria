---
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';
import { projects } from '../data/projects';

interface Props {
  slug: string;
  /** Short line under the title in the hero, e.g. an instruction for the demo */
  hint?: string;
  /** Set when the scene has its own controls bottom-right, so the hero card stays compact */
  compactHero?: boolean;
}

const { slug, hint, compactHero = false } = Astro.props;
const index = projects.findIndex((p) => p.slug === slug);
const project = projects[index];
const next = projects[(index + 1) % projects.length];
---

<Base
  modern
  title={`${project.title} — Duditeria`}
  description={`${project.title}: ${project.description}`}
  canonical={`https://duditeria.com/projects/${slug}`}
>
  <SiteHeader current="projects" />

  <section class="scene" data-scene>
    <slot name="scene" />

    <div class:list={['hero-card', { compact: compactHero }]}>
      <a href="/projects" class="crumb">← Projects</a>
      <h1 class="title">{project.title}</h1>
      <p class="tagline">{project.tagline}</p>
      {hint && <p class="hint"><span class="hint-dot" aria-hidden="true"></span>{hint}</p>}
    </div>

    <a href="#details" class="scroll-cue" aria-label="Scroll to details">
      <span>Details</span>
      <span class="chev" aria-hidden="true">↓</span>
    </a>
  </section>

  <main id="details" class="details">
    <aside class="meta">
      <dl>
        <div><dt>Type</dt><dd>{project.kind}</dd></div>
        <div>
          <dt>Stack</dt>
          <dd class="chips">{project.stack.map((s) => <span>{s}</span>)}</dd>
        </div>
      </dl>
      <a href={project.github} class="gh" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        View on GitHub
      </a>
    </aside>

    <article class="prose">
      <slot />
    </article>
  </main>

  <nav class="next" aria-label="Next project">
    <a href={`/projects/${next.slug}`} class="next-link">
      <span class="eyebrow">Next project</span>
      <span class="next-title">{next.title} <span class="arrow" aria-hidden="true">→</span></span>
      <span class="next-tag">{next.tagline}</span>
    </a>
  </nav>
</Base>

<style>
  /* ── Scene ───────────────────────────────────────────────────────── */
  .scene {
    position: relative;
    height: calc(100dvh - 3.75rem);
    min-height: 520px;
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid var(--m-border);
  }

  /* Fade the scene into the page at the bottom */
  .scene::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 30%;
    background: linear-gradient(to bottom, transparent, rgba(8, 8, 10, 0.75));
    pointer-events: none;
    z-index: 1;
  }

  .hero-card {
    position: absolute;
    left: clamp(1rem, 4vw, 3rem);
    bottom: clamp(1.25rem, 6vh, 3.5rem);
    z-index: 3;
    max-width: min(34rem, calc(100% - 2rem));
    pointer-events: none;
  }

  .hero-card a {
    pointer-events: auto;
  }

  .crumb {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--m-text-2);
    margin-bottom: 0.9rem;
    transition: color 0.2s ease;
  }

  .crumb:hover {
    color: var(--m-accent);
  }

  .title {
    font-size: clamp(2.6rem, 7vw, 5.2rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.95;
    color: var(--m-text);
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.6);
  }

  .tagline {
    margin-top: 0.75rem;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    color: var(--m-text-2);
    text-shadow: 0 1px 16px rgba(0, 0, 0, 0.8);
  }

  .hint {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--m-text);
    background: rgba(8, 8, 10, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--m-border);
    border-radius: 999px;
    padding: 0.4rem 0.8rem;
  }

  .hint-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--m-accent);
    box-shadow: 0 0 8px var(--m-accent);
  }

  .scroll-cue {
    position: absolute;
    right: clamp(1rem, 4vw, 3rem);
    bottom: clamp(1.25rem, 6vh, 3.5rem);
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--m-text-2);
    background: rgba(8, 8, 10, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--m-border);
    border-radius: 999px;
    padding: 0.5rem 0.95rem;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .scroll-cue:hover {
    color: var(--m-text);
    border-color: var(--m-border-strong);
  }

  .chev {
    animation: nudge 2s ease-in-out infinite;
  }

  @keyframes nudge {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(3px); }
  }

  /* Scenes with their own bottom-right controls move the cue to the top */
  .hero-card.compact ~ .scroll-cue {
    top: 1.25rem;
    bottom: auto;
  }

  /* ── Details ─────────────────────────────────────────────────────── */
  .details {
    max-width: 1160px;
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 6rem) 1.25rem;
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    scroll-margin-top: 3.75rem;
  }

  .meta {
    position: sticky;
    top: 6rem;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  dl {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--m-text-3);
    margin-bottom: 0.4rem;
  }

  dd {
    font-size: 0.95rem;
    color: var(--m-text);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .chips span {
    font-size: 0.8rem;
    color: var(--m-text-2);
    border: 1px solid var(--m-border);
    border-radius: 999px;
    padding: 0.25rem 0.6rem;
  }

  .gh {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: #0b0b0b;
    background: var(--m-text);
    border-radius: 999px;
    padding: 0.65rem 1.1rem;
    transition: background 0.2s ease;
  }

  .gh:hover {
    background: var(--m-accent);
  }

  /* ── Prose (slotted content) ─────────────────────────────────────── */
  .prose {
    max-width: 44rem;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .prose :global(h2) {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--m-accent);
    margin-bottom: 1rem;
  }

  .prose :global(.lead) {
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.35;
    color: var(--m-text);
  }

  .prose :global(p) {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--m-text-2);
  }

  .prose :global(p + p) {
    margin-top: 1rem;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    color: var(--m-text);
    background: var(--m-surface-2);
    border: 1px solid var(--m-border);
    border-radius: 5px;
    padding: 0.08em 0.35em;
  }

  .prose :global(em) {
    font-style: normal;
    color: var(--m-text);
  }

  .prose :global(ul.list) {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .prose :global(ul.list li) {
    position: relative;
    padding-left: 1.5rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--m-text-2);
  }

  .prose :global(ul.list li::before) {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--m-accent);
  }

  .prose :global(.defs) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 10px;
  }

  .prose :global(.def) {
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--m-border);
    border-radius: 14px;
    background: linear-gradient(180deg, var(--m-surface), rgba(15, 15, 18, 0.6));
  }

  .prose :global(.def strong) {
    display: block;
    font-size: 1rem;
    font-weight: 600;
    color: var(--m-text);
    margin-bottom: 0.35rem;
  }

  .prose :global(.def span) {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--m-text-2);
  }

  .prose :global(pre) {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.65;
    color: var(--m-text-2);
    background: var(--m-surface);
    border: 1px solid var(--m-border);
    border-radius: 14px;
    padding: 1.1rem 1.25rem;
    overflow-x: auto;
  }

  .prose :global(pre code) {
    font-size: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
  }

  /* ── Next project ────────────────────────────────────────────────── */
  .next {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 1.25rem 5rem;
  }

  .next-link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 2rem;
    border: 1px solid var(--m-border);
    border-radius: 20px;
    background:
      radial-gradient(80% 140% at 100% 100%, var(--m-accent-soft), transparent 60%),
      var(--m-surface);
    transition: border-color 0.2s ease;
  }

  .next-link:hover {
    border-color: var(--m-border-strong);
  }

  .next-title {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    color: var(--m-text);
  }

  .next-tag {
    color: var(--m-text-2);
  }

  .arrow {
    display: inline-block;
    color: var(--m-text-3);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .next-link:hover .arrow {
    color: var(--m-accent);
    transform: translateX(4px);
  }

  /* ── Scene labels (created by scene-labels.js) ───────────────────── */
  .scene :global(.scene-labels) {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    overflow: hidden;
  }

  .scene :global(.scene-label) {
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--m-text);
    background: rgba(8, 8, 10, 0.7);
    border: 1px solid var(--m-border-strong);
    border-radius: 6px;
    padding: 0.2rem 0.45rem;
    margin-top: -10px;
    white-space: nowrap;
    transition: opacity 0.3s ease;
  }

  /* ── Responsive ──────────────────────────────────────────────────── */
  @media (max-width: 860px) {
    .details {
      grid-template-columns: 1fr;
    }

    .meta {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-end;
      justify-content: space-between;
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--m-border);
    }

    dl {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1.5rem;
    }
  }

  @media (max-width: 700px) {
    /* Scenes with bottom controls: title goes to the top on small screens */
    .hero-card.compact {
      top: 1rem;
      bottom: auto;
    }
    .hero-card.compact .title { font-size: 2.4rem; }
    .hero-card.compact .tagline { font-size: 0.95rem; }
    .hero-card.compact ~ .scroll-cue { display: none; }
  }

  @media (max-width: 600px) {
    .scroll-cue span:first-child { display: none; }
    .scroll-cue { padding: 0.5rem 0.7rem; }
    .scene :global(.scene-label) { font-size: 0.6rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .chev { animation: none; }
  }
</style>
